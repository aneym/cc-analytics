{
  "version": "1.0.0",
  "lastChecked": "2025-01-27",
  "hookEvents": [
    "Setup",
    "SessionStart",
    "SessionEnd",
    "UserPromptSubmit",
    "PreToolUse",
    "PostToolUse",
    "PostToolUseFailure",
    "SubagentStart",
    "SubagentStop",
    "PermissionRequest",
    "Notification",
    "Stop",
    "PreCompact",
    "FakeTestEvent"
  ],
  "interfaces": {
    "SetupInput": {
      "fields": ["session_id", "cwd", "trigger"],
      "required": ["session_id", "cwd", "trigger"]
    },
    "SessionStartInput": {
      "fields": ["session_id", "cwd"],
      "required": ["session_id", "cwd"]
    },
    "SessionEndInput": {
      "fields": ["session_id", "cwd", "duration_ms"],
      "required": ["session_id", "cwd", "duration_ms"]
    },
    "UserPromptSubmitInput": {
      "fields": ["session_id", "prompt"],
      "required": ["session_id", "prompt"]
    },
    "ToolUseInput": {
      "fields": ["session_id", "tool_name", "tool_input"],
      "required": ["session_id", "tool_name", "tool_input"]
    },
    "PostToolUseInput": {
      "fields": ["session_id", "tool_name", "tool_input", "tool_response", "duration_ms"],
      "required": ["session_id", "tool_name", "tool_input"]
    },
    "SubagentInput": {
      "fields": ["session_id", "agent_id", "agent_type", "prompt"],
      "required": ["session_id", "agent_id", "agent_type"]
    },
    "SubagentStopInput": {
      "fields": ["session_id", "agent_id", "agent_type", "prompt", "duration_ms", "tool_count", "stop_hook_active", "agent_transcript_path"],
      "required": ["session_id", "agent_id", "agent_type"]
    },
    "PermissionRequestInput": {
      "fields": ["session_id", "tool_name", "tool_input"],
      "required": ["session_id", "tool_name", "tool_input"]
    },
    "NotificationInput": {
      "fields": ["session_id", "message", "notification_type"],
      "required": ["session_id", "message", "notification_type"]
    },
    "StopInput": {
      "fields": ["session_id", "reason", "stop_hook_active"],
      "required": ["session_id", "reason"]
    },
    "PreCompactInput": {
      "fields": ["session_id", "trigger", "custom_instructions"],
      "required": ["session_id", "trigger"]
    }
  }
}
